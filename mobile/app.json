{
  "expo": {
    "name": "Dream Rushes",
    "slug": "dream-rushes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dreamrushes",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.dreamrushes",
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "NSMicrophoneUsageDescription": "Dream Rushes listens while you tell your dream.",
        "NSCameraUsageDescription": "Dream Rushes takes a photo for a person or place in your cast.",
        "NSPhotoLibraryUsageDescription": "Dream Rushes picks a photo for a person or place in your cast."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0d16",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.dreamrushes"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0d16",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0a0d16"
  }
}
