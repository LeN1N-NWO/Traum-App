# Copy to .env and fill in. NEVER commit the real .env — this file
# (.env.example) has no real values, so it's safe to commit.

# fal.ai — image generation (Nano Banana 2). Key-Format: "KEY_ID:KEY_SECRET",
# siehe https://fal.ai/dashboard/keys.
FAL_KEY="YOUR_KEY_ID:YOUR_KEY_SECRET"

# Higgsfield — video generation (Seedance). Get keys at
# https://cloud.higgsfield.ai (API keys). Image generation no longer uses
# Higgsfield (see FAL_KEY above) — video generation still does.
HF_CREDENTIALS="YOUR_KEY_ID:YOUR_KEY_SECRET"

# Optional: override model slugs if the platform names differ from defaults —
# UNVERIFIED assumptions, confirm in each platform's own model catalog.
# FAL_MODEL_IMAGE="fal-ai/nano-banana-2"
# HF_MODEL_VIDEO="seedance-2/text-to-video"

# Optional: change port (default 8100)
# PORT=8100
