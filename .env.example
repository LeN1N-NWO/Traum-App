# Copy to .env and fill in — get keys at https://cloud.higgsfield.ai (API keys).
# NEVER commit the real .env. This file (.env.example) is safe to commit.

HF_CREDENTIALS="YOUR_KEY_ID:YOUR_KEY_SECRET"

# Optional: override model slugs if the platform names differ from defaults.
# Confirm exact slugs in your Higgsfield dashboard model catalog.
# HF_MODEL_IMAGE="nano-banana-2/text-to-image"
# HF_MODEL_VIDEO="seedance-2/text-to-video"

# Optional: change port (default 8100)
# PORT=8100
