# Copy to .env and fill in. NEVER commit the real .env — this file
# (.env.example) has no real values, so it's safe to commit.

# fal.ai — image generation (Nano Banana 2) AND video generation
# (minimax/h3, image-to-video). Required for any generation to work.
# Key-Format: "KEY_ID:KEY_SECRET", siehe https://fal.ai/dashboard/keys.
FAL_KEY="YOUR_KEY_ID:YOUR_KEY_SECRET"

# DeepSeek — OPTIONAL. Crafts the Nano Banana prompt from the dream text and
# named-reference metadata (DeepSeek is text-only, never sees the actual
# photos — those go straight to fal.ai). Without this key, generation still
# works via a local prompt template, just less richly worded.
# Get a key at https://platform.deepseek.com (API keys).
# DEEPSEEK_KEY="YOUR_KEY"

# Optional: override model slugs/names if they differ from defaults —
# UNVERIFIED assumptions except FAL_MODEL_VIDEO (given directly by the
# product owner) — confirm all of these in each platform's own catalog.
# FAL_MODEL_IMAGE="fal-ai/nano-banana-2"
# FAL_MODEL_VIDEO="minimax/h3/image-to-video"
# DEEPSEEK_MODEL="deepseek-v4-flash"

# Optional: change port (default 8100)
# PORT=8100
